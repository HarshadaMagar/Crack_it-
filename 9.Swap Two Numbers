#include <stdio.h>

int main() {
    int temp, a, b;

    printf("Enter number of a: ");
    scanf("%d", &a);

    printf("Enter number of b: ");
    scanf("%d", &b);

    temp = a;
    a = b;
    b = temp;

    printf("After swapping:\n");
    printf("a = %d\n", a);
    printf("b = %d\n", b);

    return 0;
}
