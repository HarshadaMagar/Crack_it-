#include <stdio.h>
#include <limits.h>
#include <float.h>

int main() {
    printf("--- TEXT (Characters) ---\n");
    printf("char size     : %zu byte\n", sizeof(char));
    printf("char range    : %d to %d\n\n", CHAR_MIN, CHAR_MAX);

    printf("--- WHOLE NUMBERS (Integers) ---\n");
    printf("int size      : %zu bytes\n", sizeof(int));
    printf("int range     : %d to %d\n\n", INT_MIN, INT_MAX);

    printf("--- LARGE WHOLE NUMBERS (Long) ---\n");
    printf("long size     : %zu bytes\n", sizeof(long));
    printf("long range    : %ld to %ld\n\n", LONG_MIN, LONG_MAX);

    printf("--- DECIMALS (Floating-Point) ---\n");
    printf("float size    : %zu bytes\n", sizeof(float));
    printf("float digits  : %d digits of precision\n\n", FLT_DIG);

    printf("double size   : %zu bytes\n", sizeof(double));
    printf("double digits : %d digits of precision\n", DBL_DIG);

    return 0;
}
