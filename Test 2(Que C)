#include <stdio.h>

int main()
{
    int n, i;
    
    printf("Enter n: ");
    scanf("%d", &n);

    int a[n];

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    int max = a[0], min = a[0];
    int maxIndex = 0, minIndex = 0;
    int sum = 0;

    for(i = 0; i < n; i++)
    {
        sum += a[i];

        if(a[i] > max)
        {
            max = a[i];
            maxIndex = i;
        }

        if(a[i] < min)
        {
            min = a[i];
            minIndex = i;
        }
    }

    float average = (float)sum / n;

    int count = 0;

    for(i = 0; i < n; i++)
    {
        if(a[i] > average)
        {
            count++;
        }
    }

    printf("max = %d at index %d\n", max, maxIndex);
    printf("min = %d at index %d\n", min, minIndex);
    printf("sum = %d\n", sum);
    printf("average = %.2f\n", average);
    printf("elements above average = %d", count);

    return 0;
}
